+static void web_json_string(pstring& out, const pstring& text)
+{
+    out += "\"";
+    for (const char* c = text; *c; ++c) {
+        if (*c == '"' || *c == '\\') { out += "\\"; out += *c; }
+        else if ((unsigned char) *c < 0x20) out += ' ';
+        else out += *c;
+    }
+    out += "\"";
+}
+
+/* The buttons the reader can press now, for the page to show them again
+ * under the picture: {"wait":1,"buttons":[...]}, each with its area in game
+ * pixels and, for a choice made of text (select), that text, its style and
+ * its two colours (off, and under the pointer). */
+const char* PonscripterLabel::webButtons()
+{
+    static pstring out;
+    out = "{\"wait\":";
+    out += (event_mode & WAIT_BUTTON_MODE) ? "1" : "0";
+    out += ",\"buttons\":[";
+    bool first = true;
+    for (ButtonElt::iterator it = buttons.begin(); it != buttons.end(); ++it) {
+        ButtonElt& b = it->second;
+        if (b.isSprite() && !sprite_info[b.sprite_no].showing()) continue;
+        if (b.select_rect.w <= 0 || b.select_rect.h <= 0) continue;
+        if (!first) out += ",";
+        first = false;
+        pstring item;
+        item.format("{\"id\":%d,\"x\":%d,\"y\":%d,\"w\":%d,\"h\":%d",
+                    it->first, b.select_rect.x, b.select_rect.y,
+                    b.select_rect.w, b.select_rect.h);
+        out += item;
+        // Text, on a button of its own (select) or a sprite (":s#off#on;text").
+        AnimationInfo* anim = b.isSprite() ? &sprite_info[b.sprite_no]
+                            : b.isTmpSprite() ? b.anim[0] : NULL;
+        if (anim && anim->trans_mode == AnimationInfo::TRANS_STRING
+            && anim->color_list.size() >= 2 && anim->file_name) {
+            // The text as it reads: no markers or style codes.
+            Fontinfo f = sentence_font;
+            f.style = Default;
+            pstring text;
+            int style = -1;
+            const char* c = anim->file_name;
+            while (*c) {
+                if (*c == file_encoding->TextMarker()) { ++c; continue; }
+                int bytes;
+                wchar u = file_encoding->DecodeWithLigatures(c, f, bytes);
+                if (!f.processCode(c)) {
+                    if (style < 0 && u != ' ') style = f.style;
+                    text += file_encoding->Encode(u);
+                }
+                c += bytes;
+            }
+            out += ",\"text\":";
+            web_json_string(out, text);
+            item.format(",\"choice\":%d,\"style\":%d,\"off\":%d,\"on\":%d}",
+                b.isTmpSprite() ? 1 : 0, style < 0 ? 0 : style,
+                (anim->color_list[0].r << 16) | (anim->color_list[0].g << 8) | anim->color_list[0].b,
+                (anim->color_list[1].r << 16) | (anim->color_list[1].g << 8) | anim->color_list[1].b);
+            out += item;
+        }
+        else out += "}";
+    }
+    out += "]}";
+    return out;
+}
+
+extern "C" {
+EMSCRIPTEN_KEEPALIVE const char* web_buttons()
+{
+    return web_label ? web_label->webButtons() : "{\"wait\":0,\"buttons\":[]}";
+}
+
+/* The picture as last composed, 32-bit pixels (bytes B, G, R, A). */
+EMSCRIPTEN_KEEPALIVE void* web_screen_pixels()
+{
+    return web_label ? web_label->webScreen()->pixels : NULL;
+}
+EMSCRIPTEN_KEEPALIVE int web_screen_pitch()
+{
+    return web_label ? web_label->webScreen()->pitch : 0;
+}
+}
